# ─────────────────────────────────────────────────────────────
# DevSync — Environment Variables (EXAMPLE / TEMPLATE)
# Copy to `.env.local` and fill with real values for local use.
# NEVER commit real secrets. Values here are placeholders only.
#
# Supabase is now wired into the app (client factories + middleware).
# The app still DEPLOYS with none of these set — Supabase clients and the
# session-refresh middleware no-op gracefully until configured. The Supabase
# URL + anon key become REQUIRED once auth/data features are enabled.
# See docs/architecture/14-Environment-Variables.md for the full spec.
# ─────────────────────────────────────────────────────────────

# ── PUBLIC (exposed to the browser via the NEXT_PUBLIC_ prefix) ──
# Safe to expose. The anon key is NOT a security boundary — Row-Level
# Security is. Never place a service-role key behind a NEXT_PUBLIC_ name.

# Canonical site URL (used for metadata, absolute URLs, OAuth redirects).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Environment label for non-secret UI/telemetry context.
# One of: development | preview | production
NEXT_PUBLIC_APP_ENV="development"

# Supabase project URL, e.g. https://<project-ref>.supabase.co
# Consumed by the browser, server, and middleware Supabase clients.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase anonymous/publishable key. Public by design; RLS is the boundary.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ── SERVER-ONLY (NEVER prefix with NEXT_PUBLIC_; never sent to client) ──
# Not read anywhere yet. Placeholder for the admin/database sprint. The
# service-role key bypasses Row-Level Security — server-only, highest
# sensitivity. Uncomment and set only when the server admin client is added.

# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Direct/pooled Postgres connection string for migrations & admin tooling.
# SUPABASE_DB_URL="postgresql://user:password@host:port/database"
