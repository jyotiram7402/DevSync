# ─────────────────────────────────────────────────────────────
# CopyAnywhere (DevSync) — Environment Variables (EXAMPLE / TEMPLATE)
# Copy to `.env.local` and fill with real values for local use.
# NEVER commit real secrets. Values here are placeholders only.
# Preview/production values live in Vercel → Project → Settings →
# Environment Variables.
#
# Every variable is optional for the build: without the Supabase URL and
# anon key the app still renders, but sign-in and data show "not
# configured". Both are required for anything beyond the landing page.
# ─────────────────────────────────────────────────────────────

# ── PUBLIC (exposed to the browser via the NEXT_PUBLIC_ prefix) ──
# Safe to expose. The anon key is NOT a security boundary — Row-Level
# Security is. Never place a service-role key behind a NEXT_PUBLIC_ name.

# Canonical site URL (metadata and absolute URLs built on the server;
# the browser uses its own origin).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Environment label for non-secret UI context.
# One of: development | preview | production
NEXT_PUBLIC_APP_ENV="development"

# Supabase project URL: Supabase → Project Settings → API.
# Consumed by the browser, server, and middleware Supabase clients.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase anonymous/publishable key: Supabase → Project Settings → API.
# Public by design; RLS is the boundary.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional: "1" turns on realtime debug logs and the connection debug panel.
NEXT_PUBLIC_REALTIME_DEBUG="0"

# ── SERVER-ONLY (NEVER prefix with NEXT_PUBLIC_; never sent to client) ──
# Not read anywhere yet; reserved for a future admin client. The
# service-role key bypasses Row-Level Security — highest sensitivity.

# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Direct/pooled Postgres connection string for admin tooling.
# SUPABASE_DB_URL="postgresql://user:password@host:port/database"

# Set automatically by Vercel / Next.js — never set by hand: VERCEL_ENV, NODE_ENV.
# The extension and the Android app have their own templates:
# extension/.env.example and mobile/.env.example.
