{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Disabled deliberately: it conflicts with idiomatic React/JSX optional
    // props (passing `undefined` to mean "absent"). The web app hit the same
    // wall. `strict` + noUncheckedIndexedAccess still catch real bugs.
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["../*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
