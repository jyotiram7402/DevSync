# Expo public env (EXPO_PUBLIC_ vars are inlined at build time). Public values
# only — the anon key is safe because RLS is the security boundary. No secrets.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_DEVSYNC_URL=https://devsync.app
