# DevSync extension build-time environment (Vite exposes VITE_-prefixed vars).
# Copy to .env.local before building. These are PUBLIC values only — never put
# a service-role key or any secret here; the anon key is safe (RLS is the boundary).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where the popup's "Open dashboard" / "Sign in on the web" links point.
VITE_DEVSYNC_URL=https://devsync.app
